# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://finora_user:finora_password@localhost:5432/finora_db

# Redis Configuration (BullMQ & Caching)
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_example
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_example
JWT_REFRESH_EXPIRES_IN=7d

# External APIs
OPENAI_API_KEY=sk-test-key
ANTHROPIC_API_KEY=sk-ant-test-key
